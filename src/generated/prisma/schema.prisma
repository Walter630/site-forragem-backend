generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  cpf       String    @unique
  senha     String
  ativado   Boolean   @default(true) @db.TinyInt()
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt DateTime? @map("deleted_at") @db.DateTime()

  tipoUserId Int?
  tipoUser   TipoUser? @relation(fields: [tipoUserId], references: [id])

  propriedade Propriedade?

  @@map("admins")
}

model TipoUser {
  id        Int       @id @default(autoincrement())
  tipo      String
  descricao String?   @db.Text() // sem default
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt DateTime? @map("deleted_at") @db.DateTime()
  ativado   Boolean   @default(true) @db.TinyInt()

  admins Admin[]

  @@map("tipo_users")
}

model Propriedade {
  id               Int       @id @default(autoincrement())
  nomeProprietario String
  nomePropriedade  String
  latitude         Float
  longitude        Float
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt        DateTime? @map("deleted_at") @db.DateTime()

  adminId Int?   @unique
  admin   Admin? @relation(fields: [adminId], references: [id])

  estimativas        Estimativas[]
  simulacoes         Simulacao[]
  historicos         Historico[]
  precipitacoes      Precipitacao[]
  propriedadeCultura PropriedadeCultura[]
  propriedadeSolo    PropriedadeSolo[]
  Solo               Solo[] // via N:N PropriedadeSolo

  @@map("propriedades")
}

model PropriedadeCultura {
  id            Int         @id @default(autoincrement())
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int
  cultura       Cultura     @relation(fields: [culturaId], references: [id])
  culturaId     Int

  @@unique([propriedadeId, culturaId])
  @@map("propriedade_culturas")
}

model PropriedadeSolo {
  id            Int         @id @default(autoincrement())
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int
  solo          Solo        @relation(fields: [soloId], references: [id])
  soloId        Int

  @@unique([propriedadeId, soloId])
  @@map("propriedade_solos")
}

model Historico {
  id             Int          @id @default(autoincrement())
  descricao      String? // sem default
  valorSimulacao Float
  propriedadeId  Int
  propriedade    Propriedade  @relation(fields: [propriedadeId], references: [id])
  simulacaoId    Int
  simulacao      Simulacao    @relation(fields: [simulacaoId], references: [id])
  soloId         Int
  solo           Solo         @relation(fields: [soloId], references: [id])
  precipitacaoId Int
  precipitacao   Precipitacao @relation(fields: [precipitacaoId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@map("historicos")
}

model Precipitacao {
  id        Int       @id @default(autoincrement())
  mmAno     Float
  chuvas    Float
  mmDia     Float
  cvDia     Float
  mmMes     Float
  cvMes     Float
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt DateTime? @map("deleted_at") @db.DateTime()

  propriedadeId Int
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])

  historico Historico[]

  @@map("precipitacao")
}

model Solo {
  id                       Int       @id @default(autoincrement())
  nomeClasse               String
  profundidade             Float
  fatorRocha               Float
  condutHidraulicaSaturada Float
  densidadeAparente        Float
  agua0Bar                 Float
  agua13Bar                Float
  agua15Bar                Float
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt                DateTime? @map("deleted_at") @db.DateTime()

  historico       Historico[]
  propriedadeSolo PropriedadeSolo[]
  Propriedade     Propriedade?      @relation(fields: [propriedadeId], references: [id])
  propriedadeId   Int?

  @@map("solos")
}

model Estimativas {
  id         Int       @id @default(autoincrement())
  valorTotal Float
  descricao  String? // sem default
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt  DateTime? @map("deleted_at") @db.DateTime()

  propriedadeId Int
  simulacaoId   Int
  simulacao     Simulacao    @relation(fields: [simulacaoId], references: [id])
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])

  @@map("estimativas")
}

model Simulacao {
  id            Int       @id @default(autoincrement())
  nomeSimulacao String
  dadosJson     Json? // sem default
  culturaId     Int
  soloId        Int
  resultado     Float
  dataSimulacao DateTime
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt     DateTime? @map("deleted_at") @db.DateTime()

  propriedadeId Int
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])

  historico   Historico[]
  estimativas Estimativas[]

  @@map("simulacoes")
}

model Cultura {
  id        Int       @id @default(autoincrement())
  name      String
  eua       Float
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.DateTime()
  deletedAt DateTime? @map("deleted_at") @db.DateTime()

  PropriedadeCultura PropriedadeCultura[]

  @@map("culturas")
}
