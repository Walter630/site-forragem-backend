generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/**
 * Ajustes feitos:
 * - Propriedade.adminId NÃO é mais `@unique` (um Admin pode ter várias propriedades).
 * - Removi relação duplicada Solo <-> Propriedade (mantive PropriedadeSolo como join table).
 * - Adicionei mais campos de clima na Simulacao conforme sua UI (ETO, indiceAridez, mmAno, nº chuvas, mmDia, cvDia, mmMes, cvMes, altitude, temperaturaMed, umidade).
 * - Normalizei nomes e padronizei createdAt/updatedAt maps em alguns modelos.
 * - Mantive collections mapeadas via @@map para Mongo.
 */

enum TipoUsuarioEnum {
  ADMIN
  GERENTE
  FUNCIONARIO
  USER
}

model Admin {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  nome    String
  email   String  @unique
  cpf     String  @unique
  senha   String
  ativado Boolean @default(true)

  tipoUsuario TipoUsuarioEnum @default(GERENTE)

  // Relacionamento: Gerente pode ter funcionários
  gerenteId    String? @db.ObjectId
  gerente      Admin?  @relation("GerenteFuncionarios", fields: [gerenteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcionarios Admin[] @relation("GerenteFuncionarios")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  propriedades Propriedade[]

  @@map("admins")
}

model Propriedade {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  nomePropriedade String
  nomeResponsavel String
  latitude        Float
  longitude       Float

  adminId String? @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])

  // relações join
  culturas   PropriedadeCultura[]
  solos      PropriedadeSolo[]
  simulacoes Simulacao[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  Historico    Historico[]
  Precipitacao Precipitacao[]
  Estimativas  Estimativas[]

  @@map("propriedades")
}

model PropriedadeCultura {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  culturaId     String      @db.ObjectId
  cultura       Cultura     @relation(fields: [culturaId], references: [id])

  @@unique([propriedadeId, culturaId])
  @@map("propriedade_culturas")
}

model PropriedadeSolo {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  soloId        String      @db.ObjectId
  solo          Solo        @relation(fields: [soloId], references: [id])

  @@unique([propriedadeId, soloId])
  @@map("propriedade_solos")
}

model Historico {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  simulacaoId String    @db.ObjectId
  simulacao   Simulacao @relation(fields: [simulacaoId], references: [id])

  observacao String?

  propriedadeId String?      @db.ObjectId
  Propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])

  precipitacaoId String?       @db.ObjectId
  Precipitacao   Precipitacao? @relation(fields: [precipitacaoId], references: [id])

  soloId String? @db.ObjectId
  Solo   Solo?   @relation(fields: [soloId], references: [id])

  createdAt DateTime @default(now())

  @@map("historicos")
}

model Precipitacao {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  mmAno  Float? // precipitação anual
  chuvas Float? // número de chuvas (ou contagem)
  mmDia  Float? // precipitação média diária
  cvDia  Float?
  mmMes  Float?
  cvMes  Float?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])

  historico Historico[]

  @@map("precipitacoes")
}

model Solo {
  id                       String @id @default(auto()) @map("_id") @db.ObjectId
  nomeClasse               String @unique // ex.: "cambissolo" ou pode armazenar código/string
  profundidade             Float?
  fatorRocha               Float?
  condutHidraulicaSaturada Float?
  densidadeAparente        Float?
  agua0Bar                 Float?
  agua13Bar                Float?
  agua15Bar                Float?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  historico       Historico[]
  propriedadeSolo PropriedadeSolo[]
  Simulacao       Simulacao[]

  @@map("solos")
}

model Estimativas {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  valorTotal Float?
  descricao  String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  propriedadeId String? @db.ObjectId
  simulacaoId   String  @db.ObjectId

  simulacao   Simulacao?   @relation(fields: [simulacaoId], references: [id])
  propriedade Propriedade? @relation(fields: [propriedadeId], references: [id])

  @@map("estimativas")
}

model Simulacao {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  nomeSimulacao String
  ano           Int

  culturaId String  @db.ObjectId
  cultura   Cultura @relation(fields: [culturaId], references: [id])

  soloId String @db.ObjectId
  solo   Solo   @relation(fields: [soloId], references: [id])

  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])

  // Dados de clima — adicionei os campos que aparecem nas telas
  eto               Float? // ETo (mm/ano)
  indiceAridez      Float?
  precipitacaoMmAno Float?
  numeroChuvas      Float?
  precipitacaoMmDia Float?
  cvDia             Float?
  precipitacaoMmMes Float?
  cvMes             Float?
  altitude          Float?

  // outros dados climáticos/gerais
  temperaturaMed Float?
  umidade        Float?

  resultado     Float?
  dataSimulacao DateTime @default(now())

  historicos Historico[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  Estimativas Estimativas[]

  @@map("simulacoes")
}

model Cultura {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  eua       Float? // eficiência uso de água (g H2O por g MS)
  codigo    Int? // opcional: 1 = PN, 2 = CP, 3 = PM (se quiser usar códigos)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  PropriedadeCultura PropriedadeCultura[]
  Simulacao          Simulacao[]

  @@map("culturas")
}
