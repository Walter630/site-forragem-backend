generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  nome    String
  email   String  @unique
  cpf     String  @unique
  senha   String
  ativado Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tipoUserId String?   @db.ObjectId
  tipoUser   TipoUser? @relation(fields: [tipoUserId], references: [id])

  propriedade Propriedade?

  @@map("admins")
}

model TipoUser {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tipo      String
  descricao String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  ativado   Boolean   @default(true)

  admins Admin[]

  @@map("tipo_users")
}

model Propriedade {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  nomePropriedade String
  nomeResponsavel String
  latitude        Float
  longitude       Float

  adminId String? @unique @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])

  culturas   PropriedadeCultura[]
  solos      PropriedadeSolo[]
  simulacoes Simulacao[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  Historico    Historico[]
  Precipitacao Precipitacao[]
  Solo         Solo[]
  Estimativas  Estimativas[]
}

model PropriedadeCultura {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  culturaId     String      @db.ObjectId
  cultura       Cultura     @relation(fields: [culturaId], references: [id])

  @@unique([propriedadeId, culturaId])
  @@map("propriedade_culturas")
}

model PropriedadeSolo {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  soloId        String      @db.ObjectId
  solo          Solo        @relation(fields: [soloId], references: [id])

  @@unique([propriedadeId, soloId])
  @@map("propriedade_solos")
}

model Historico {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  simulacaoId String    @db.ObjectId
  simulacao   Simulacao @relation(fields: [simulacaoId], references: [id])

  observacao String?

  propriedadeId String?      @db.ObjectId
  Propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])

  precipitacaoId String?       @db.ObjectId
  Precipitacao   Precipitacao? @relation(fields: [precipitacaoId], references: [id])

  soloId String? @db.ObjectId
  Solo   Solo?   @relation(fields: [soloId], references: [id])

  createdAt DateTime @default(now())
}

model Precipitacao {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  mmAno  Float
  chuvas Float
  mmDia  Float
  cvDia  Float
  mmMes  Float
  cvMes  Float

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])

  historico Historico[]

  @@map("precipitacao")
}

model Solo {
  id                       String @id @default(auto()) @map("_id") @db.ObjectId
  nomeClasse               String
  profundidade             Float
  fatorRocha               Float
  condutHidraulicaSaturada Float
  densidadeAparente        Float
  agua0Bar                 Float
  agua13Bar                Float
  agua15Bar                Float

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  historico       Historico[]
  propriedadeSolo PropriedadeSolo[]
  Propriedade     Propriedade?      @relation(fields: [propriedadeId], references: [id])
  propriedadeId   String?           @db.ObjectId

  Simulacao Simulacao[]

  @@map("solos")
}

model Estimativas {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  valorTotal Float
  descricao  String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  propriedadeId String @db.ObjectId
  simulacaoId   String @db.ObjectId

  simulacao   Simulacao    @relation(fields: [simulacaoId], references: [id])
  propriedade Propriedade? @relation(fields: [propriedadeId], references: [id])

  @@map("estimativas")
}

model Simulacao {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  nomeSimulacao String
  ano           Int

  culturaId String  @db.ObjectId
  cultura   Cultura @relation(fields: [culturaId], references: [id])

  soloId String @db.ObjectId
  solo   Solo   @relation(fields: [soloId], references: [id])

  propriedadeId String      @db.ObjectId
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])

  chuvaAnual     Float
  temperaturaMed Float
  umidade        Float

  resultado     Float?
  dataSimulacao DateTime @default(now())

  historicos Historico[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  Estimativas Estimativas[]
}

model Cultura {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  eua       Float
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  PropriedadeCultura PropriedadeCultura[]
  Simulacao          Simulacao[]

  @@map("culturas")
}
